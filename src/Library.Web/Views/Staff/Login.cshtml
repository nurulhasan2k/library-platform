@model LoginForm
@{ ViewData["Title"] = "Staff sign in"; }
<div class="card form">
  <h1>Staff sign in</h1>
  <p class="muted">For administrators, reception and managers. Patrons sign in at <a href="/account">My account</a>.</p>
  <form method="post" asp-antiforgery="true" action="/staff/login">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <label for="Username">Username</label>
    <input id="Username" name="Username" type="text" value="@Model.Username" autocomplete="username" autofocus required />
    <label for="Password">Password</label>
    <input id="Password" name="Password" type="password" autocomplete="current-password" required />
    <p style="margin-top:1rem"><button class="btn" type="submit">Sign in</button></p>
  </form>
  <details class="small muted"><summary>Demo accounts</summary>
    <p>admin / admin123 &middot; reception / reception123 &middot; reception.river / reception123 &middot; manager / manager123</p>
  </details>
</div>
