@model IReadOnlyList<Borrower>
@{ ViewData["Title"] = "Borrowers"; }
<div class="page-head"><h1>Borrowers</h1><a class="btn" href="/borrowers/new">Add a borrower</a></div>
<form method="get" class="filters"><div class="grow"><label for="q">Search</label><input id="q" name="q" type="search" value="@ViewBag.Q" placeholder="Name, card, phone, email" /></div><div><button class="btn" type="submit">Search</button></div></form>
<div class="table-wrap"><table class="table stack">
  <thead><tr><th>Name</th><th>Card</th><th>Phone</th><th>Email</th><th>Notify by</th><th></th></tr></thead>
  <tbody>
  @foreach (var b in Model)
  {
    <tr><td data-label="Name"><a href="/borrowers/@b.Id">@b.Name</a></td><td data-label="Card"><code>@b.CardNumber</code></td><td data-label="Phone">@b.Phone</td><td data-label="Email">@b.Email</td>
        <td data-label="Notify by">@b.PreferredChannel</td><td class="right"><a class="btn btn-ghost btn-sm" href="/borrowers/@b.Id/edit">Edit</a></td></tr>
  }
  </tbody></table>
  @if (Model.Count == 0) { <div class="empty">No borrowers match.</div> }
</div>
