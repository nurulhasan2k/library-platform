@model IReadOnlyList<Library.Web.Models.Import.ImportBatchViewModel>
@{ ViewData["Title"] = "Import history"; }
<h1>Import history</h1>
<p><a asp-action="Index">Start an import</a></p>
<p>History is cleared when the application restarts.</p>
@if (Model.Count == 0) { <p>No imports have been confirmed yet.</p> }
else
{
    <table class="table"><thead><tr><th>Batch</th><th>Source</th><th>File</th><th>Admin ID</th><th>At</th><th>Target branch ID</th><th>Total</th><th>Created</th><th>Rejected</th></tr></thead><tbody>
    @foreach (var batch in Model)
    {
        <tr><td><a asp-action="Result" asp-route-id="@batch.Id">@batch.Id</a></td><td>@batch.Source</td><td>@batch.FileName</td><td>@batch.ByUserId</td><td>@batch.At.ToString("yyyy-MM-dd HH:mm")</td><td>@batch.TargetBranchId</td><td>@batch.RowsTotal</td><td>@batch.RowsCreated</td><td>@batch.RowsRejected</td></tr>
    }
    </tbody></table>
}
