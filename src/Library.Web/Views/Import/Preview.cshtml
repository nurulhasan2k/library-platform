@model Library.Web.Controllers.ImportPreviewPage
@{ ViewData["Title"] = "Review import"; var p = Model.Preview; }
<h1>Review before importing</h1>
<p class="muted">Source: <strong>@p.Source</strong> &middot; items go to <strong>@Model.BranchName</strong> unless a row names another branch.</p>
<div class="grid grid-3">
  <div class="stat"><div class="num">@p.Rows.Count</div><div class="label">rows read</div></div>
  <div class="stat"><div class="num" style="color:var(--color-ok)">@p.ValidCount</div><div class="label">ready to import</div></div>
  <div class="stat"><div class="num" style="color:var(--color-danger)">@p.InvalidCount</div><div class="label">have problems and will be skipped</div></div>
</div>
<div class="actions" style="margin:1rem 0">
  <form method="post" asp-antiforgery="true" action="/admin/import/commit"><input type="hidden" name="token" value="@Model.Token" /><button class="btn btn-ok" type="submit" disabled="@(p.ValidCount == 0)">Import @Fmt.Plural(p.ValidCount, "valid row", "valid rows")</button></form>
  <form method="post" asp-antiforgery="true" action="/admin/import/cancel"><input type="hidden" name="token" value="@Model.Token" /><button class="btn btn-ghost" type="submit">Cancel</button></form>
  @if (p.InvalidCount > 0 && p.Source.EndsWith(".csv", StringComparison.OrdinalIgnoreCase)) { <a class="btn btn-ghost" href="/admin/import/problems/@Model.Token">Download the problems as CSV</a> }
</div>
<div class="table-wrap"><table class="table stack">
  <thead><tr><th>Line</th><th>Type</th><th>Code</th><th>Name</th><th>Category</th><th>Result</th></tr></thead>
  <tbody>
  @foreach (var r in p.Rows)
  {
    <tr class="@(r.IsValid ? "" : "row-bad")">
      <td data-label="Line">@r.Record.RowNumber</td><td data-label="Type">@r.Record.Type</td><td data-label="Code"><code>@r.Record.Code</code></td><td data-label="Name">@r.Record.Name</td><td data-label="Category">@r.Record.Category</td>
      <td data-label="Result">@if (r.IsValid) { <span class="badge ok">OK</span> } else { <span class="badge bad">Skipped</span><ul class="small" style="margin:.3rem 0 0 1rem;padding:0">@foreach (var e in r.Errors) { <li>@e</li> }</ul> }</td>
    </tr>
  }
  </tbody></table></div>
