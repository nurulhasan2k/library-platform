{
  // Every key below is documented in docs/CONFIGURATION.md.
  // Override locally with appsettings.Development.json, `dotnet user-secrets` or environment variables
  // (for example Api__Key). Never commit a real API key or password.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "ConnectionString": "Data Source=data/library.db",
    "SeedOnStartup": true
  },

  "Lending": {
    "LoanDays": 14,
    "FinePerDay": 0.50
  },

  "Auth": {
    "MaxPinAttempts": 5,
    "LockoutMinutes": 5
  },

  "Kiosk": {
    "BranchCode": "CENTRAL",
    "IdleTimeoutSeconds": 60
  },

  "Notifications": {
    "DueSoonDays": 2,
    "EnableScheduler": true
  },

  "Reservations": {
    "MaxActiveHoldsPerPatron": 5,
    "ReadyHoldDays": 3
  },

  "Api": {
    "Key": "",
    "RateLimitPerMinute": 60,
    "MaxPageSize": 100,
    "EnableSwagger": true
  },

  "Import": {
    "MaxFileSizeMb": 5,
    "MaxRows": 5000
  },

  "Reports": {
    "IdleItemDays": 90
  }
}
