{
  // Every key below is documented in docs/CONFIGURATION.md.
  // Override locally with appsettings.Development.json, `dotnet user-secrets` or environment variables
  // (for example Api__Key). The Api:Key below is a DEMO value for the marker; use a real secret outside the demo.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "DataFile": "data/library.json",
    "SeedOnStartup": true
  },

  "Lending": {
    "LoanDays": 14,
    "FinePerDay": 0.50
  },

  "Auth": {
    "MaxPinAttempts": 5,
    "LockoutMinutes": 5
  },

  "Kiosk": {
    "BranchCode": "CENTRAL",
    "IdleTimeoutSeconds": 60
  },

  "Notifications": {
    "DueSoonDays": 2,
    "EnableScheduler": true
  },

  "Reservations": {
    "MaxActiveHoldsPerPatron": 5,
    "ReadyHoldDays": 3
  },

  "Api": {
    "Key": "demo-api-key-2026",
    "RateLimitPerMinute": 60,
    "MaxPageSize": 100,
    "EnableDocs": true
  },

  "Import": {
    "MaxFileSizeMb": 5,
    "MaxRows": 2000
  },

  "Reports": {
    "IdleItemDays": 90
  }
}
